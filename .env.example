# Copy to .env (gitignored) and fill in. Never commit real keys.
# Both are optional — the system runs fully keyless, degrading gracefully.

# the-odds-api.com — 500 credits/month.
# Unlocks: upcoming fixtures + live odds for every league (incl. Liga MX, MLS),
# and switches the market-comparison / EV layer onto real prices.
ODDS_API_KEY=

# api-football.com — ~100 requests/day.
# Unlocks: CURRENT club squads (named scorers/assists on club league pages),
# confirmed lineups, and injuries for the availability features.
API_FOOTBALL_KEY=

# Optional: enables ReAct agent mode and the LLM-as-judge eval arm.
# ANTHROPIC_API_KEY=

# Where paused approvals live. Unset = process memory (lost on restart).
# sqlite:///relative/path.db or sqlite:////absolute/path.db survives a restart
# on ONE host with a persistent local disk (not a network filesystem, not an
# ephemeral container, not replicas on separate hosts).
# needs: pip install -e ".[durable]"
# CHECKPOINT_URL=sqlite:///data/checkpoints/runs.db

# Native threads per model call (default 1; raise for batch training)
# MODEL_THREADS=1

# Gateway auth + rate limit (set a key for anything shared)
# GATEWAY_API_KEY=
# PREDICT_RATE_LIMIT=5/minute

# Optional mobile adapter (uvicorn gateway.mobile:app --port 8011).
# Demo is keyless. Live requires a separate phone/session access token and
# delegates to the existing /predict gateway; provider keys stay server-side.
SOCCER_GATEWAY_URL=
SOCCER_GATEWAY_API_KEY=
MOBILE_API_KEY=
# Comma-separated explicit browser preview origins. Native apps do not use CORS.
MOBILE_ALLOWED_ORIGINS=http://localhost:8081
MOBILE_TIMEOUT_SECONDS=45
